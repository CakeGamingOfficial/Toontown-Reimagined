; Toontown playtest launcher. Edit this file with the Godot editor UI
; if you change display settings. The game itself lives in the sibling project.

config_version=5

[application]

config/name="Toontown Launcher"
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
