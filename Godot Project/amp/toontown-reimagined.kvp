App.AdminMethod=STDIO
App.ApplicationPort1=4343
App.ApplicationReadyMode=RegexMatch
App.BaseDirectory=./toontown-reimagined/
App.CommandLineArgs=start-server.sh
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=-{0} "{1}"
App.DisplayName=Toontown Reimagined
App.ExecutableLinux=/bin/bash
App.ExecutableWin=
App.ExitMethod=OS_CLOSE
App.ExitString=
App.HasReadableConsole=true
App.HasWritableConsole=false
App.RapidStartup=false
App.RootDir=./toontown-reimagined/
App.UpdateSource=None
App.WorkingDir=
Console.AppReadyRegex=^Dedicated server listening on UDP port \d+\.$
Console.ThrowawayMessageRegex=
Console.UserChatRegex=
Console.UserJoinRegex=^Peer (?<userid>\d+) joined .+\. \d+ connected\.$
Console.UserLeaveRegex=^(?<username>.+) disconnected\. \d+ still connected\.$
