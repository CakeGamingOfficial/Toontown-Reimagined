; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Toontown"
run/main_scene="uid://bcdtunrhkw36x"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dotnet]

project/assembly_name="Project Toontown"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=16
