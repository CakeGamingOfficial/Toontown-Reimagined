; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Toontown-Reimagined"
run/main_scene="uid://dh6s3kjjrtt0d"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ClipPack="*res://scenes/boot/clip_pack.gd"
ToonCursor="*res://scenes/gui/toon_cursor.gd"
ToonAudioBus="*res://scenes/audio/toon_audio.gd"
ToonLoadingScreen="*res://scenes/gui/loading_screen.gd"
StreetTraffic="*res://scenes/streets/street_traffic.gd"
ToonNetwork="*res://scenes/net/toon_net.gd"
MiniGolfBus="*res://scenes/golf/minigolf_matches.gd"
RaceBus="*res://scenes/racing/race_matches.gd"
ToonSocialBus="*res://scenes/net/toon_social.gd"
DevConsole="*res://scenes/debug/dev_console.gd"
DiscordPresence="*res://scenes/discord/discord_presence.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dotnet]

project/assembly_name="Project Toontown"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
